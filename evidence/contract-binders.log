@MilgromSegal.absolutelyContinuous_value.{u_1} : ∀ {X : Type u_1} [Nonempty.{u_1 + 1} X] {f : X → ℝ → ℝ} {b : ℝ → ℝ},
  MilgromSegal.FiniteValue.{u_1} f →
    (∀ (x : X), AbsolutelyContinuousOnInterval.{0} (f x) 0 1) →
      IntervalIntegrable.{0} b MeasureTheory.volume.{0} 0 1 →
        (∀ (x : X),
            ∀ᵐ (t : ℝ), Membership.mem.{0, 0} (Set.Icc.{0} 0 1) t → LE.le.{0} (abs.{0} (deriv.{0, 0} (f x) t)) (b t)) →
          AbsolutelyContinuousOnInterval.{0} (MilgromSegal.value.{u_1} f) 0 1
@MilgromSegal.derivative_identity.{u_1} : ∀ {X : Type u_1} [Nonempty.{u_1 + 1} X] {f : X → ℝ → ℝ},
  MilgromSegal.FiniteValue.{u_1} f →
    ∀ {t : ℝ},
      Membership.mem.{0, 0} (Set.Ioo.{0} 0 1) t →
        ∀ {x : X},
          MilgromSegal.Optimizes.{u_1} f t x →
            DifferentiableAt.{0, 0, 0} ℝ (f x) t →
              DifferentiableAt.{0, 0, 0} ℝ (MilgromSegal.value.{u_1} f) t →
                Eq.{1} (deriv.{0, 0} (MilgromSegal.value.{u_1} f) t) (deriv.{0, 0} (f x) t)
@MilgromSegal.right_derivative_inequality.{u_1} : ∀ {X : Type u_1} [Nonempty.{u_1 + 1} X] {f : X → ℝ → ℝ},
  MilgromSegal.FiniteValue.{u_1} f →
    ∀ {t d D : ℝ},
      Membership.mem.{0, 0} (Set.Icc.{0} 0 1) t →
        LT.lt.{0} t 1 →
          ∀ {x : X},
            MilgromSegal.Optimizes.{u_1} f t x →
              HasDerivWithinAt.{0, 0} (f x) d (Set.Icc.{0} 0 1) t →
                HasDerivWithinAt.{0, 0} (MilgromSegal.value.{u_1} f) D (Set.Ioi.{0} t) t → LE.le.{0} d D
