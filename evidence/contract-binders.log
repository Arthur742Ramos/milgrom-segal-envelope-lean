            (∀ (x : X) (t : ℝ), Membership.mem.{0, 0} (Set.Ioo.{0} 0 1) t → DifferentiableAt.{0, 0, 0} ℝ (f x) t) →
              (∀ᵐ (t : ℝ), Membership.mem.{0, 0} (Set.Ioo.{0} 0 1) t → ∃ x, MilgromSegal.Optimizes.{u_1} f t x) →
                AbsolutelyContinuousOnInterval.{0} (MilgromSegal.value.{u_1} f) 0 1 ∧
                  (∃ sel,
