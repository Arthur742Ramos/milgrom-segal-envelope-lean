@MilgromSegal.integral_envelope.{u_1} : ∀ {X : Type u_1} [Nonempty.{u_1 + 1} X] {f : X → ℝ → ℝ} {b : ℝ → ℝ},
  MilgromSegal.FiniteValue.{u_1} f →
